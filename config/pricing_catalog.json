{
  "source": {
    "url": "https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json",
    "timeoutSeconds": 15,
    "cacheFile": "cache/litellm-model-prices.json"
  },
  "filters": {
    "allModels": true,
    "providers": [],
    "includeModels": []
  },
  "providerWhitelist": [
    "openai",
    "anthropic",
    "gemini",
    "deepseek",
    "moonshot",
    "zai",
    "mistral",
    "xai",
    "minimax",
    "meta"
  ],
  "iconSource": {
    "baseUrl": "icons/providers",
    "sourceUrl": "https://github.com/lobehub/lobe-icons/tree/master/packages/static-svg/icons",
    "preferRemote": false,
    "aliases": {
      "zai": "zhipu",
      "google-gemini": "gemini",
      "amazon-nova": "aws",
      "dashscope": "qwen",
      "bedrock": "aws",
      "bedrock-converse": "aws",
      "bedrock-mantle": "aws",
      "vertex-ai": "google-cloud",
      "watsonx": "ibm",
      "jina-ai": "jina",
      "fireworks-ai": "fireworks",
      "together-ai": "together",
      "openrouter": "openrouter"
    }
  },
  "defaults": {
    "cacheField": "cache_read_input_token_cost",
    "cacheFallback": "input",
    "multiplier": 1,
    "fxRate": 7.2,
    "comparisonRatio": 4,
    "comparisonHit": 30,
    "comparisonTotal": 100
  },
  "fallbackModels": [
    {
      "id": "fallback-gpt-5.6-sol",
      "name": "GPT-5.6 Sol",
      "provider": "OpenAI",
      "providerId": "openai",
      "category": "openai",
      "categoryId": "provider-openai",
      "sourceModelId": "gpt-5.6-sol",
      "targetId": "sol",
      "cache": 0.5,
      "input": 5,
      "output": 30
    },
    {
      "id": "fallback-gpt-5.6-terra",
      "name": "GPT-5.6 Terra",
      "provider": "OpenAI",
      "providerId": "openai",
      "category": "openai",
      "categoryId": "provider-openai",
      "sourceModelId": "gpt-5.6-terra",
      "targetId": "terra",
      "cache": 0.2,
      "input": 2,
      "output": 12
    },
    {
      "id": "fallback-gpt-5.6-luna",
      "name": "GPT-5.6 Luna",
      "provider": "OpenAI",
      "providerId": "openai",
      "category": "openai",
      "categoryId": "provider-openai",
      "sourceModelId": "gpt-5.6-luna",
      "targetId": "luna",
      "cache": 0.02,
      "input": 0.2,
      "output": 1.2
    }
  ],
  "modelMappings": {
    "gpt-5.6-sol": {"targetId": "sol"},
    "gpt-5.6-terra": {"targetId": "terra"},
    "gpt-5.6-luna": {"targetId": "luna"},
    "deepseek-v4-pro": {"targetId": "custom-1785420925987"},
    "deepseek-v4-flash": {"targetId": "custom-1785420926994"}
  },
  "categories": {
    "reasoning": {
      "name": "Reasoning",
      "patterns": ["*reasoning*", "*o1*", "*o3*", "*o4*"]
    },
    "coding": {
      "name": "Coding",
      "patterns": ["*code*", "*coder*"]
    }
  },
  "providers": {
    "openai": {"name": "OpenAI", "icon": "icons/brands/openai.svg"},
    "anthropic": {"name": "Anthropic", "icon": "icons/brands/anthropic.svg"},
    "gemini": {"name": "Google Gemini", "icon": "icons/brands/gemini.svg"},
    "deepseek": {"name": "DeepSeek", "icon": "icons/brands/deepseek.svg"},
    "moonshot": {"name": "Moonshot / Kimi", "icon": "icons/brands/moonshot.svg"},
    "zai": {"name": "Zhipu / GLM", "icon": "icons/brands/zhipu.svg"},
    "meta": {"name": "Meta", "icon": "icons/brands/meta.svg"},
    "mistral": {"name": "Mistral", "icon": "icons/brands/mistral.svg"},
    "minimax": {"name": "MiniMax", "icon": "icons/brands/minimax.svg"},
    "xai": {"name": "xAI", "icon": "icons/brands/xai.svg"}
  }
}
